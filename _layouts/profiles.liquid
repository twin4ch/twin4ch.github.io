---
layout: page
---

<div class="post">
  <article>
    {% assign roles = page.profiles | map: "role" | uniq %}
    {% for role in roles %}
      <h2>{{ role }}</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 20px;">
        {% for profile in page.profiles %}
          {% if profile.role == role %}
            {{ profile.url }}
              {{ profile.image }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </article>
</div>

