---
layout: page
---

<style>
  .profile-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .profile-card {
    text-align: center;
    transition: transform 0.3s ease;
  }

  .profile-card:hover {
    transform: scale(1.05);
  }

  .profile-name {
    margin-top: 8px;
    font-weight: 500;
  }
</style>

<div class="post">
  <article>
    {% assign roles = page.profiles | map: "role" | uniq %}
    {% for role in roles %}
      <h2>{{ role }}</h2>
      <div class="profile-grid">
        {% for profile in page.profiles %}
          {% if profile.role == role %}
            <div class="profile-card">
            <a href="{{ profile.url }}">
                {% assign profile_image_path = profile.image | prepend: 'assets/img/profile/' %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
                {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.name %}
              </a>
              <div class="profile-name">
                <a href="{{ profile.email }}">
                {{ profile.name }}
                </a>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </article>
</div>
